# Custom Project Exclusions
# Ignore data contents, but track directory placeholders using .gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/preprocessing_pipeline.joblib
!data/processed/feature_names.json
data/external/*
!data/external/.gitkeep
logs/*
!logs/.gitkeep
models/*
!models/.gitkeep
!models/best_model.joblib
!models/feature_names.json

# System files
.DS_Store
Thumbs.db
